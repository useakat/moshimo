{
  "permissions": {
    "deny": [
      "Write(.claude/settings.local.json)",
      "Edit(.claude/settings.local.json)"
    ],
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(mkdir -p *)",
      "Bash(npm *)",
      "Bash(git -C /root/moshimo status)",
      "Bash(git -C /root/moshimo diff *)",
      "Bash(git -C /root/moshimo log *)",
      "Bash(git -C /root/moshimo add *)",
      "Bash(git -C /root/moshimo commit *)",
      "Bash(gh run list *)"
    ]
  }
}
